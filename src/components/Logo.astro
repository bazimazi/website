---
interface Props {
  class?: string;
  /** Hide the wordmark and show only the mark. */
  markOnly?: boolean;
}
const { class: className, markOnly = false } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg class="logo__mark" viewBox="0 0 48 48" aria-hidden="true">
    <path d="M9 40C6 28 7 15 14 9c6-5 14-5 20 0 7 6 8 19 5 31-7 4-23 4-30 0Z" fill="#ff8a1f"></path>
    <path d="M9 40c7 4 23 4 30 0" stroke="#e2660a" stroke-width="3" fill="none" stroke-linecap="round"></path>
    <circle cx="17.5" cy="20" r="7" fill="#fff"></circle>
    <circle cx="30.5" cy="20" r="7" fill="#fff"></circle>
    <circle class="logo__pupil" cx="18.5" cy="21" r="3.6" fill="#1b0f2e"></circle>
    <circle class="logo__pupil" cx="31.5" cy="21" r="3.6" fill="#1b0f2e"></circle>
    <path d="M20 30c2.4 3 5.6 3 8 0" stroke="#3a1408" stroke-width="2.4" fill="none" stroke-linecap="round"></path>
  </svg>
  {
    !markOnly && (
      <span class="logo__word latin" aria-label="bazimazi">
        <span aria-hidden="true">
          baz<span class="logo__i">ı<i /></span>maz<span class="logo__i">ı<i /></span>
        </span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    direction: ltr;
  }
  .logo__mark {
    width: 38px;
    height: 38px;
    flex: none;
    transition: transform 0.4s var(--ease-spring);
  }
  .logo__word {
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .logo__i {
    position: relative;
    display: inline-block;
  }
  .logo__i i {
    position: absolute;
    top: -0.02em;
    left: 50%;
    width: 0.25em;
    height: 0.25em;
    margin-left: -0.125em;
    border-radius: 50%;
    background: var(--firouzeh);
  }
  .logo__i + .logo__i i,
  .logo__i:last-child i {
    background: var(--anar);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(a:hover) > .logo .logo__mark,
    .logo:hover .logo__mark {
      transform: rotate(-8deg) scale(1.06);
    }
    :global(a:hover) > .logo .logo__i i,
    .logo:hover .logo__i i {
      animation: logo-hop 0.6s var(--ease-out);
    }
    :global(a:hover) > .logo .logo__i:last-child i,
    .logo:hover .logo__i:last-child i {
      animation-delay: 0.1s;
    }
  }
  @keyframes logo-hop {
    40% {
      transform: translateY(-0.35em) scale(1.1, 0.9);
    }
    70% {
      transform: translateY(0.02em) scale(1.15, 0.85);
    }
  }
</style>
