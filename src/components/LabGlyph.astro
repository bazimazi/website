---
import type { Glyph } from '~/data/lab';

interface Props {
  glyph: Glyph;
}
const { glyph } = Astro.props;
---

<svg class:list={['glyph', `glyph--${glyph}`]} viewBox="0 0 160 100" aria-hidden="true">
  <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    {
      glyph === 'combat' && (
        <>
          <rect x="18" y="58" width="24" height="24" rx="6" class="dim" />
          <rect x="118" y="20" width="24" height="24" rx="6" class="dim" />
          <path d="M42 70 80 22l38 10" class="faint" stroke-dasharray="4 7" />
          <circle class="ball g-combat" cx="42" cy="70" r="8" />
        </>
      )
    }
    {
      glyph === 'build' && (
        <>
          <g class="g-spin">
            <rect x="74" y="20" width="12" height="12" rx="3" class="dim" />
            <rect x="74" y="68" width="12" height="12" rx="3" class="dim" />
            <path d="M104 50h12M44 50h12" />
          </g>
          <circle class="ball" cx="80" cy="50" r="14" />
        </>
      )
    }
    {
      glyph === 'ramp' && (
        <>
          <path d="M20 26 100 70h40" />
          <path d="M126 70v-8l6-4-6-4 6-4" class="dim" />
          <circle class="ball g-ramp" cx="26" cy="18" r="8" />
        </>
      )
    }
    {
      glyph === 'gravity' && (
        <>
          <circle cx="80" cy="50" r="34" class="faint" stroke-dasharray="3 8" />
          <g class="g-spin-step">
            <path d="M80 62v22m-7-7 7 7 7-7" />
          </g>
          <circle class="ball" cx="80" cy="50" r="10" />
        </>
      )
    }
    {
      glyph === 'arena' && (
        <>
          <ellipse cx="80" cy="54" rx="64" ry="34" class="dim" />
          <circle class="ball g-arena-a" cx="56" cy="54" r="9" />
          <circle class="ball ball--alt g-arena-b" cx="104" cy="54" r="9" />
        </>
      )
    }
    {
      glyph === 'runner' && (
        <>
          <g class="g-scroll">
            <path d="M0 80h50M66 80h60M142 80h60M218 80h50" />
          </g>
          <circle class="ball g-hop" cx="52" cy="70" r="9" />
        </>
      )
    }
    {
      glyph === 'logic' && (
        <>
          <path d="M24 74h40V30h40v44h32" class="faint" stroke-dasharray="4 7" />
          <path d="M136 74V50l14 6-14 6" class="dim" />
          <circle class="ball g-logic" cx="24" cy="74" r="8" />
        </>
      )
    }
    {
      glyph === 'magnet' && (
        <>
          <path d="M38 24v30a22 22 0 0 0 44 0V24" stroke-width="12" class="mag" />
          <path d="M38 24v10M82 24v10" stroke-width="12" class="dim" />
          <circle class="ball g-magnet" cx="124" cy="56" r="10" />
        </>
      )
    }
    {
      glyph === 'rewind' && (
        <>
          <path d="M20 74h120" class="faint" />
          <circle class="ball ghosty" cx="40" cy="64" r="8" />
          <circle class="ball g-rewind" cx="40" cy="64" r="8" />
          <g class="g-spin-rev">
            <path d="M128 28a14 14 0 1 0 4 10" />
            <path d="M126 20l2 8 8-2" />
          </g>
        </>
      )
    }
    {
      glyph === 'orbit' && (
        <>
          <circle cx="80" cy="50" r="16" class="planet" />
          <ellipse cx="80" cy="50" rx="52" ry="30" class="faint" stroke-dasharray="3 7" />
          <g class="g-orbit">
            <circle class="ball" cx="132" cy="50" r="7" />
          </g>
        </>
      )
    }
    {
      glyph === 'alchemy' && (
        <>
          <path d="M40 20l6 12 12 6-12 6-6 12-6-12-12-6 12-6Z" class="dim g-twinkle" />
          <path d="M122 56l4 8 8 4-8 4-4 8-4-8-8-4 8-4Z" class="dim g-twinkle g-late" />
          <circle class="ball g-alchemy" cx="80" cy="50" r="16" />
        </>
      )
    }
    {
      glyph === 'ghost' && (
        <>
          <path d="M20 78c30 0 30-50 60-50s30 50 60 50" class="faint" stroke-dasharray="4 7" />
          <circle class="ball ghosty g-path g-late2" cx="20" cy="70" r="8" />
          <circle class="ball ghosty g-path g-late" cx="20" cy="70" r="8" />
          <circle class="ball g-path" cx="20" cy="70" r="8" />
        </>
      )
    }
    {
      glyph === 'fluid' && (
        <>
          <path class="g-wave" d="M-40 60c20-10 30-10 50 0s30 10 50 0 30-10 50 0 30 10 50 0 30-10 50 0" />
          <path d="M0 90h160" class="faint" />
          <circle class="ball g-bob" cx="80" cy="46" r="10" />
        </>
      )
    }
    {
      glyph === 'cell' && (
        <>
          <circle cx="66" cy="50" r="24" class="dim g-breathe" />
          <circle cx="104" cy="50" r="14" class="dim g-breathe g-late" />
          <circle class="ball" cx="66" cy="50" r="8" />
          <circle class="ball ball--alt" cx="104" cy="50" r="5" />
        </>
      )
    }
    {
      glyph === 'dungeon' && (
        <>
          <path d="M20 20h40v24H20zM76 20h64v24H76zM20 58h56v24H20zM92 58h48v24H92z" class="dim" />
          <path d="M60 32h16M76 70h16M40 44v14M116 44v14" class="faint" />
          <circle class="ball g-dungeon" cx="40" cy="32" r="6" />
        </>
      )
    }
    {
      glyph === 'rift' && (
        <>
          <g class="g-spin">
            <path d="M80 10v12M80 78v12M40 50h12M108 50h12M52 22l8 8M100 70l8 8M108 22l-8 8M52 78l8-8" class="dim" />
          </g>
          <ellipse cx="80" cy="50" rx="16" ry="26" class="portal" />
          <circle class="ball g-breathe" cx="80" cy="50" r="7" />
        </>
      )
    }
    {
      glyph === 'pachinko' && (
        <>
          {[0, 1, 2, 3].map((r) => [0, 1, 2, 3, 4].map((c) => <circle cx={44 + c * 18 + (r % 2) * 9} cy={22 + r * 18} r="2.5" class="dim" fill="currentColor" />))}
          <path d="M40 92v-8h80v8" class="dim" />
          <circle class="ball g-plumb" cx="80" cy="8" r="6" />
        </>
      )
    }
    {
      glyph === 'defense' && (
        <>
          <g class="g-bob">
            <rect x="30" y="12" width="18" height="18" rx="5" class="dim" />
            <rect x="70" y="12" width="18" height="18" rx="5" class="dim" />
            <rect x="110" y="12" width="18" height="18" rx="5" class="dim" />
          </g>
          <path d="M20 82h120" class="faint" stroke-dasharray="6 6" />
          <circle class="ball g-combat" cx="60" cy="66" r="7" />
        </>
      )
    }
    {
      glyph === 'swarm' && (
        <>
          {[
            [20, 20], [140, 24], [24, 80], [136, 78], [80, 10], [80, 92], [12, 50], [150, 52],
          ].map(([x, y], i) => (
            <circle class="dim g-swarm" cx={x} cy={y} r="4" style={`--sx:${80 - x}px;--sy:${50 - y}px;animation-delay:${i * 0.12}s`} />
          ))}
          <circle class="ball" cx="80" cy="50" r="10" />
        </>
      )
    }
  </g>
</svg>

<style>
  .glyph {
    width: 100%;
    height: 100%;
    overflow: visible;
    color: currentColor;
  }
  .glyph :global(*) {
    transform-box: fill-box;
    transform-origin: center;
  }
  .glyph .dim {
    opacity: 0.55;
  }
  .glyph .faint {
    opacity: 0.3;
  }
  .glyph .ball {
    fill: var(--glyph-ball, #ffb81c);
    stroke: none;
  }
  .glyph .ball--alt {
    fill: var(--glyph-alt, #20c4b4);
  }
  .glyph .ghosty {
    opacity: 0.3;
  }
  .glyph .planet {
    fill: color-mix(in srgb, currentColor 18%, transparent);
  }
  .glyph .portal {
    fill: color-mix(in srgb, var(--glyph-alt, #20c4b4) 30%, transparent);
    stroke: var(--glyph-alt, #20c4b4);
  }
  .glyph .mag {
    stroke: var(--glyph-red, #e8434a);
  }

  @media (prefers-reduced-motion: no-preference) {
    .glyph :global([class*='g-']) {
      animation-play-state: paused;
      animation-duration: 2s;
      animation-iteration-count: infinite;
      animation-timing-function: ease-in-out;
    }
    :global(.is-playing) .glyph :global([class*='g-']) {
      animation-play-state: running;
    }
    .g-late {
      animation-delay: -0.25s !important;
    }
    .g-late2 {
      animation-delay: -0.5s !important;
    }
    .g-combat {
      animation-name: g-combat;
    }
    .g-spin {
      animation-name: g-spin;
      animation-timing-function: linear !important;
      animation-duration: 6s !important;
    }
    .g-spin-rev {
      animation-name: g-spin;
      animation-direction: reverse;
      animation-timing-function: linear !important;
    }
    .g-spin-step {
      transform-box: view-box !important;
      transform-origin: 80px 50px !important;
      animation-name: g-spin-step;
      animation-duration: 4s !important;
    }
    .g-ramp {
      animation-name: g-ramp;
      animation-timing-function: cubic-bezier(0.5, 0, 0.6, 1) !important;
    }
    .g-arena-a {
      animation-name: g-arena-a;
    }
    .g-arena-b {
      animation-name: g-arena-b;
    }
    .g-scroll {
      animation-name: g-scroll;
      animation-timing-function: linear !important;
      animation-duration: 1.5s !important;
    }
    .g-hop {
      animation-name: g-hop;
      animation-duration: 0.75s !important;
      animation-timing-function: cubic-bezier(0.3, 0, 0.7, 1) !important;
    }
    .g-logic {
      animation-name: g-logic;
      animation-duration: 3s !important;
    }
    .g-magnet {
      animation-name: g-magnet;
    }
    .g-rewind {
      animation-name: g-rewind;
      animation-duration: 2.4s !important;
    }
    .g-orbit {
      transform-box: view-box !important;
      transform-origin: 80px 50px !important;
      animation-name: g-orbit;
      animation-timing-function: linear !important;
      animation-duration: 3s !important;
    }
    .g-alchemy {
      animation-name: g-alchemy;
      animation-duration: 3s !important;
    }
    .g-twinkle {
      animation-name: g-twinkle;
    }
    .g-path {
      animation-name: g-path;
      animation-duration: 2.4s !important;
    }
    .g-wave {
      animation-name: g-wave;
      animation-timing-function: linear !important;
    }
    .g-bob {
      animation-name: g-bob;
    }
    .g-breathe {
      animation-name: g-breathe;
    }
    .g-dungeon {
      animation-name: g-dungeon;
      animation-duration: 4s !important;
    }
    .g-swarm {
      animation-name: g-swarm;
    }
    .g-plumb {
      animation-name: g-plumb;
      animation-duration: 2.2s !important;
      animation-timing-function: ease-in !important;
    }
  }
  @keyframes g-combat {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(38px, -48px);
    }
    75% {
      transform: translate(70px, -40px);
    }
  }
  @keyframes g-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes g-spin-step {
    0%,
    20% {
      transform: rotate(0);
    }
    25%,
    45% {
      transform: rotate(90deg);
    }
    50%,
    70% {
      transform: rotate(180deg);
    }
    75%,
    95% {
      transform: rotate(270deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }
  @keyframes g-ramp {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    60% {
      transform: translate(74px, 42px);
    }
    90% {
      transform: translate(106px, 44px);
      opacity: 1;
    }
    100% {
      transform: translate(106px, 44px);
      opacity: 0;
    }
  }
  @keyframes g-arena-a {
    0%,
    100% {
      transform: translateX(-20px);
    }
    45% {
      transform: translateX(14px);
    }
  }
  @keyframes g-arena-b {
    0%,
    100% {
      transform: translateX(20px);
    }
    45% {
      transform: translateX(-14px);
    }
  }
  @keyframes g-scroll {
    to {
      transform: translateX(-76px);
    }
  }
  @keyframes g-hop {
    0%,
    100% {
      transform: translateY(0) scale(1.1, 0.9);
    }
    50% {
      transform: translateY(-34px);
    }
  }
  @keyframes g-logic {
    0% {
      transform: translate(0, 0);
    }
    20% {
      transform: translate(40px, 0);
    }
    40% {
      transform: translate(40px, -44px);
    }
    60% {
      transform: translate(80px, -44px);
    }
    80% {
      transform: translate(80px, 0);
    }
    100% {
      transform: translate(112px, 0);
    }
  }
  @keyframes g-magnet {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(-26px);
      fill: var(--glyph-alt, #20c4b4);
    }
  }
  @keyframes g-rewind {
    0% {
      transform: translateX(0);
    }
    70% {
      transform: translateX(80px);
    }
    100% {
      transform: translateX(0);
    }
  }
  @keyframes g-orbit {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes g-alchemy {
    0%,
    100% {
      fill: #ffb81c;
    }
    33% {
      fill: #e8434a;
    }
    66% {
      fill: #20c4b4;
    }
  }
  @keyframes g-twinkle {
    50% {
      transform: scale(0.5) rotate(45deg);
      opacity: 0.2;
    }
  }
  @keyframes g-path {
    0%,
    100% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(26px, -34px);
    }
    50% {
      transform: translate(60px, -50px);
    }
    75% {
      transform: translate(94px, -34px);
    }
    95% {
      transform: translate(120px, 0);
    }
  }
  @keyframes g-wave {
    to {
      transform: translateX(50px);
    }
  }
  @keyframes g-bob {
    50% {
      transform: translateY(8px);
    }
  }
  @keyframes g-breathe {
    50% {
      transform: scale(1.12);
    }
  }
  @keyframes g-dungeon {
    0%,
    100% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(70px, 0);
    }
    50% {
      transform: translate(70px, 38px);
    }
    75% {
      transform: translate(0, 38px);
    }
  }
  @keyframes g-plumb {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    30% {
      transform: translate(-9px, 18px);
    }
    50% {
      transform: translate(0, 36px);
    }
    70% {
      transform: translate(9px, 54px);
    }
    90% {
      transform: translate(0, 72px);
      opacity: 1;
    }
    100% {
      transform: translate(0, 76px);
      opacity: 0;
    }
  }
  @keyframes g-swarm {
    0%,
    100% {
      transform: translate(0, 0);
    }
    60% {
      transform: translate(calc(var(--sx) * 0.55), calc(var(--sy) * 0.55));
    }
  }
</style>
