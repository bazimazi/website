---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/vazirmatn';
import '@fontsource/lalezar/arabic-400.css';
import '~/styles/global.css';

import Footer from '~/components/Footer.astro';
import Header from '~/components/Header.astro';
import { SITE } from '~/config';
import { dir, localize, t, unlocalize, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
  title?: string;
  description: string;
  image?: string;
  /** Extra JSON-LD for the page (merged into the graph). */
  schema?: Record<string, unknown>;
  noindex?: boolean;
}

const { lang, title, description, image = lang === 'fa' ? '/og/bazimazi-fa.png' : '/og/bazimazi.png', schema, noindex = false } = Astro.props;
const ui = t(lang);
const fullTitle = title ? `${title} · bazimazi` : lang === 'fa' ? 'بازی‌مازی · بازی‌های ساده، با روح ایرانی' : 'bazimazi · Simple games. Persian soul.';
const path = unlocalize(Astro.url.pathname);
const canonical = new URL(localize(path, lang), SITE.url).href;
const alternates = (['en', 'fa'] as const).map((l) => ({ lang: l, href: new URL(localize(path, l), SITE.url).href }));
const ogImage = new URL(image, SITE.url).href;

const graph = [
  {
    '@type': 'Organization',
    '@id': `${SITE.url}/#org`,
    name: 'bazimazi',
    alternateName: 'بازی مازی',
    url: SITE.url,
    logo: `${SITE.url}/favicon.svg`,
    email: SITE.email,
    foundingDate: String(SITE.founded),
    sameAs: [SITE.github, SITE.x, SITE.npm],
  },
  ...(schema ? [schema] : []),
];
---

<!doctype html>
<html lang={lang} dir={dir(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#10133a" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="bazimazi" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'fa' ? 'fa_IR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'fa' ? 'en_US' : 'fa_IR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bazimazi" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skip}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 200;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--saffron);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }
</style>

<script>
  // Reveal elements as they scroll into view.
  const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
    );
    revealables.forEach((el) => io.observe(el));
  } else {
    revealables.forEach((el) => el.classList.add('is-visible'));
  }

  // Copy buttons on code blocks.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      const source = document.getElementById(button.dataset.copy!);
      if (!source) return;
      // Copy the commands without their prompts.
      const lines = [...source.querySelectorAll('[data-line]')].map((line) => {
        const clone = line.cloneNode(true) as HTMLElement;
        clone.querySelectorAll('.prompt').forEach((p) => p.remove());
        return clone.textContent?.trim() ?? '';
      });
      const text = lines.join('\n') || source.textContent || '';
      try {
        await navigator.clipboard.writeText(text.trim());
        const label = button.textContent;
        button.textContent = button.dataset.copied ?? '✓';
        setTimeout(() => (button.textContent = label), 1600);
      } catch {
        /* Clipboard unavailable: the text is still selectable. */
      }
    });
  }

  // Turn build-time dates into "3 days ago", in the page's language.
  const lang = document.documentElement.lang;
  const rtf = new Intl.RelativeTimeFormat(lang === 'fa' ? 'fa' : 'en', { numeric: 'auto' });
  const units: [Intl.RelativeTimeFormatUnit, number][] = [
    ['year', 31536e6],
    ['month', 2592e6],
    ['week', 6048e5],
    ['day', 864e5],
    ['hour', 36e5],
    ['minute', 6e4],
  ];
  for (const el of document.querySelectorAll<HTMLTimeElement>('time[data-relative]')) {
    const diff = Date.parse(el.dateTime) - Date.now();
    const [unit, ms] = units.find(([, ms]) => Math.abs(diff) >= ms) ?? ['minute', 6e4];
    el.textContent = rtf.format(Math.round(diff / ms), unit);
  }
</script>
