---
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
  class?: string;
  /** Static mascots do not react to clicks (e.g. inside a link). */
  interactive?: boolean;
}

const { lang, class: className, interactive = true } = Astro.props;
const phrases = {
  en: ['Bazi?', 'One more round!', 'Salam!', 'Tap the sky!', 'Again!', 'I like it here.'],
  fa: ['بازی؟', 'یه دست دیگه!', 'سلام!', 'باز هم!', 'به آسمون ضربه بزن!', 'اینجا رو دوست دارم.'],
}[lang];
const label = { en: 'The bazimazi mascot. Say hello', fa: 'شخصیت بازی‌مازی. سلام کن' }[lang];
const Tag = interactive ? 'button' : 'div';
// Unique gradient ids, so several mascots can share a page.
const uid = Math.random().toString(36).slice(2, 8);
const bodyId = `m-body-${uid}`;
const eyeId = `m-eye-${uid}`;
---

<Tag
  class:list={['mascot', className]}
  data-mascot
  data-phrases={JSON.stringify(phrases)}
  type={interactive ? 'button' : undefined}
  aria-label={interactive ? label : undefined}
  aria-hidden={interactive ? undefined : 'true'}
>
  <span class="mascot__bubble" aria-live="polite"></span>
  <svg class="mascot__svg" viewBox="0 0 240 262" aria-hidden="true">
    <defs>
      <radialGradient id={bodyId} cx="40%" cy="30%" r="80%">
        <stop offset="0" stop-color="#ffc24d"></stop>
        <stop offset="0.55" stop-color="#ff9a24"></stop>
        <stop offset="1" stop-color="#f27410"></stop>
      </radialGradient>
      <radialGradient id={eyeId} cx="50%" cy="45%" r="60%">
        <stop offset="0.7" stop-color="#ffffff"></stop>
        <stop offset="1" stop-color="#ffe9a8"></stop>
      </radialGradient>
    </defs>
    <ellipse class="mascot__shadow" cx="120" cy="250" rx="96" ry="10" fill="#000" opacity="0.22"></ellipse>
    <g class="mascot__body">
      <g class="mascot__drops" fill="#ffb81c">
        <ellipse cx="20" cy="170" rx="7" ry="10"></ellipse>
        <ellipse cx="34" cy="146" rx="4" ry="5"></ellipse>
        <ellipse cx="222" cy="176" rx="6" ry="9"></ellipse>
        <ellipse cx="210" cy="150" rx="3.5" ry="4.5"></ellipse>
      </g>
      <ellipse cx="120" cy="226" rx="98" ry="28" fill="#e2660a"></ellipse>
      <path d="M30 220c10-26 60-34 92-32s82 6 90 30c-28 14-150 16-182 2Z" fill="#f98a1c"></path>
      <path d="M64 206C50 152 48 92 66 60c16-30 92-30 108 0 18 32 16 92 2 146-22 10-90 10-112 0Z" fill={`url(#${bodyId})`}></path>
      <ellipse cx="120" cy="150" rx="30" ry="34" fill="#ffd27a" opacity="0.3"></ellipse>
      <g fill="none" stroke-width="15" stroke-linecap="round">
        <path d="M72 160c12 14 32 20 52 14" stroke="#ee7612"></path>
        <path d="M168 160c-12 14-32 20-52 14" stroke="#fb8d1e"></path>
      </g>
      <g stroke="#ff9a24" stroke-width="7" stroke-linecap="round">
        <path d="M104 44 98 22"></path>
        <path d="M136 44 142 22"></path>
      </g>
      <circle cx="98" cy="20" r="7" fill="#ffc24d"></circle>
      <circle cx="142" cy="20" r="7" fill="#ffc24d"></circle>
      <g fill="#ffd27a" opacity="0.75">
        <circle cx="96" cy="58" r="4.5"></circle>
        <circle cx="146" cy="54" r="3.5"></circle>
        <circle cx="160" cy="150" r="3"></circle>
        <circle cx="78" cy="156" r="2.5"></circle>
        <circle cx="122" cy="44" r="2.5"></circle>
      </g>
      <ellipse cx="80" cy="136" rx="10" ry="5.5" fill="#f6a7b6" opacity="0.6"></ellipse>
      <ellipse cx="160" cy="136" rx="10" ry="5.5" fill="#f6a7b6" opacity="0.6"></ellipse>
      <g class="mascot__eye" data-eye>
        <ellipse cx="84" cy="96" rx="33" ry="36" fill="#ffd25a"></ellipse>
        <ellipse cx="84" cy="96" rx="28" ry="31" fill={`url(#${eyeId})`}></ellipse>
        <g class="mascot__pupil" data-pupil>
          <circle cx="84" cy="98" r="17" fill="#1b0f2e"></circle>
          <circle cx="78" cy="91" r="5.5" fill="#fff"></circle>
          <circle cx="90" cy="104" r="2.5" fill="#fff"></circle>
        </g>
      </g>
      <g class="mascot__eye" data-eye>
        <ellipse cx="156" cy="96" rx="33" ry="36" fill="#ffd25a"></ellipse>
        <ellipse cx="156" cy="96" rx="28" ry="31" fill={`url(#${eyeId})`}></ellipse>
        <g class="mascot__pupil" data-pupil>
          <circle cx="156" cy="98" r="17" fill="#1b0f2e"></circle>
          <circle cx="150" cy="91" r="5.5" fill="#fff"></circle>
          <circle cx="162" cy="104" r="2.5" fill="#fff"></circle>
        </g>
      </g>
      <g class="mascot__mouth">
        <path d="M103 134c6 14 28 14 34 0-11 4-23 4-34 0Z" fill="#3a1408"></path>
        <ellipse cx="120" cy="142" rx="6" ry="2.6" fill="#e8434a"></ellipse>
      </g>
    </g>
  </svg>
</Tag>

<style>
  .mascot {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 240 / 262;
    -webkit-tap-highlight-color: transparent;
  }
  button.mascot {
    cursor: pointer;
    border-radius: 40%;
  }
  .mascot__svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .mascot__body {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  .mascot__eye {
    transform-box: fill-box;
    transform-origin: center;
  }
  .mascot__pupil {
    transition: transform 0.12s linear;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mascot__body {
      animation: mascot-breathe 4.2s ease-in-out infinite;
    }
    .mascot__eye {
      animation: mascot-blink 5.5s infinite;
    }
    .mascot__eye + .mascot__eye {
      animation-delay: 0.04s;
    }
    .mascot__drops {
      animation: mascot-float 3.6s ease-in-out infinite;
    }
    .mascot.is-squished .mascot__body {
      animation: mascot-squish 0.7s var(--ease-spring);
    }
  }
  @keyframes mascot-breathe {
    50% {
      transform: scale(1.015, 0.985);
    }
  }
  @keyframes mascot-blink {
    0%,
    92%,
    100% {
      transform: scaleY(1);
    }
    95% {
      transform: scaleY(0.08);
    }
  }
  @keyframes mascot-float {
    50% {
      transform: translateY(-8px);
    }
  }
  @keyframes mascot-squish {
    0% {
      transform: scale(1);
    }
    25% {
      transform: scale(1.12, 0.84);
    }
    55% {
      transform: scale(0.92, 1.1);
    }
    100% {
      transform: scale(1);
    }
  }
  .mascot__bubble {
    position: absolute;
    bottom: 96%;
    left: 50%;
    translate: -50% 0;
    padding: 8px 16px;
    border-radius: 18px;
    background: var(--paper);
    color: var(--ink);
    font-weight: 700;
    font-size: 1rem;
    white-space: nowrap;
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.4);
    opacity: 0;
    scale: 0.6;
    transform-origin: 50% 120%;
    transition:
      opacity 0.2s,
      scale 0.35s var(--ease-spring);
    pointer-events: none;
  }
  .mascot__bubble::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    translate: -50% -1px;
    border: 8px solid transparent;
    border-top-color: var(--paper);
  }
  .mascot__bubble.is-on {
    opacity: 1;
    scale: 1;
  }
</style>

<script>
  type Look = { x: number; y: number; at: number };
  const w = window as Window & { bazimaziLook?: Look };

  const mascots = [...document.querySelectorAll<HTMLElement>('[data-mascot]')];
  let pointer: Look | null = null;
  let frame = 0;

  const update = () => {
    frame = 0;
    // Follow the pointer; when it has been idle for a while, follow whatever the page points at.
    const idle = !pointer || performance.now() - pointer.at > 2500;
    const target = idle && w.bazimaziLook && performance.now() - w.bazimaziLook.at < 1000 ? w.bazimaziLook : pointer;
    for (const mascot of mascots) {
      for (const eye of mascot.querySelectorAll<SVGGElement>('[data-eye]')) {
        const pupil = eye.querySelector<SVGGElement>('[data-pupil]')!;
        if (!target) {
          pupil.style.transform = '';
          continue;
        }
        const box = eye.getBoundingClientRect();
        const dx = target.x - (box.left + box.width / 2);
        const dy = target.y - (box.top + box.height / 2);
        const dist = Math.hypot(dx, dy) || 1;
        const reach = Math.min(1, dist / 260);
        pupil.style.transform = `translate(${((dx / dist) * 9 * reach).toFixed(2)}px, ${((dy / dist) * 10 * reach).toFixed(2)}px)`;
      }
    }
  };
  const schedule = () => {
    if (!frame) frame = requestAnimationFrame(update);
  };

  if (mascots.length) {
    window.addEventListener(
      'pointermove',
      (e) => {
        pointer = { x: e.clientX, y: e.clientY, at: performance.now() };
        schedule();
      },
      { passive: true },
    );
    setInterval(schedule, 120);

    for (const mascot of mascots) {
      if (mascot.tagName !== 'BUTTON') continue;
      const bubble = mascot.querySelector<HTMLElement>('.mascot__bubble')!;
      const phrases: string[] = JSON.parse(mascot.dataset.phrases ?? '[]');
      let i = 0;
      let timer = 0;
      mascot.addEventListener('click', () => {
        mascot.classList.remove('is-squished');
        void mascot.offsetWidth;
        mascot.classList.add('is-squished');
        bubble.textContent = phrases[i++ % phrases.length];
        bubble.classList.add('is-on');
        clearTimeout(timer);
        timer = window.setTimeout(() => bubble.classList.remove('is-on'), 1800);
      });
    }
  }
</script>
