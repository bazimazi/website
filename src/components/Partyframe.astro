---
import Icon from './Icon.astro';
import { repoUrl } from '~/config';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = {
  en: {
    eyebrow: 'Tools we share',
    title: 'The TV is the game. Phones are the controllers.',
    body: 'partyframe is our open framework for Jackbox-style party games. One shared screen runs the game, and everyone in the room joins by scanning a QR code. You write the rules and two views. partyframe handles the rest.',
    features: [
      'Room codes and QR joining',
      'Reconnects phones that lock or drop Wi-Fi',
      'Bots that play by the same rules as people',
      'An authoritative server: phones send intentions, the server decides',
      'A test harness that plays a whole match in milliseconds',
      'Plural rules, right-to-left layouts, sound cues and haptics',
    ],
    cta: 'partyframe on GitHub',
    room: 'ROOM',
  },
  fa: {
    eyebrow: 'ابزارهایی که به اشتراک می‌گذاریم',
    title: 'تلویزیون خودِ بازی است. گوشی‌ها دسته‌اند.',
    body: 'partyframe چارچوب متن‌باز ما برای بازی‌های گروهی به سبک Jackbox است. یک صفحهٔ مشترک بازی را اجرا می‌کند و همه با اسکن یک کد QR وارد می‌شوند. تو قوانین و دو نما را می‌نویسی؛ بقیه‌اش با partyframe.',
    features: [
      'کد اتاق و ورود با QR',
      'اتصال دوباره برای گوشی‌هایی که قفل می‌شوند یا وای‌فای‌شان قطع می‌شود',
      'ربات‌هایی که با همان قوانین آدم‌ها بازی می‌کنند',
      'سرور معتبر: گوشی‌ها نیت می‌فرستند، سرور تصمیم می‌گیرد',
      'ابزار تستی که یک مسابقهٔ کامل را در چند میلی‌ثانیه بازی می‌کند',
      'قواعد جمع، چیدمان راست‌به‌چپ، صدا و لرزش',
    ],
    cta: 'partyframe در گیت‌هاب',
    room: 'ROOM',
  },
}[lang];

// A decorative, deterministic QR-like pattern.
const qr: [number, number][] = [];
for (let y = 0; y < 9; y++) for (let x = 0; x < 9; x++) if (((x * 7 + y * 13 + x * y) % 5) < 2) qr.push([x, y]);
const finder = [
  [0, 0],
  [6, 0],
  [0, 6],
];
const phones = [
  { x: 24, y: 270, color: '#ff8a1f', r: -8 },
  { x: 150, y: 296, color: '#20c4b4', r: -3 },
  { x: 298, y: 296, color: '#e8434a', r: 3 },
  { x: 424, y: 270, color: '#ffb81c', r: 8 },
];
---

<div class="pf">
  <div class="pf__copy">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 class="pf__title">{copy.title}</h2>
    <p class="pf__body">{copy.body}</p>
    <ul class="pf__features" role="list">
      {
        copy.features.map((f) => (
          <li>
            <Icon name="check" size={18} />
            {f}
          </li>
        ))
      }
    </ul>
    <div class="terminal pf__terminal">
      <div class="terminal__bar"><i></i><i></i><i></i><span>~/my-party-game</span></div>
      <pre id="pf-install"><span data-line><span class="prompt">$ </span>npm install @bazimazi/partyframe-server</span>
<span data-line><span class="prompt">$ </span>npm install @bazimazi/partyframe-client</span></pre>
      <button class="copy-btn" type="button" data-copy="pf-install" data-copied={lang === 'en' ? 'Copied' : 'کپی شد'}>
        {lang === 'en' ? 'Copy' : 'کپی'}
      </button>
    </div>
    <a class="link-arrow pf__link" href={repoUrl('partyframe')}>
      <Icon name="github" />
      {copy.cta}
      <Icon name="arrow" />
    </a>
  </div>

  <svg class="pf__art" viewBox="0 0 540 440" aria-hidden="true">
    <g class="pf__wires" fill="none" stroke-width="2.5" stroke-dasharray="6 8" stroke-linecap="round">
      {phones.map((p) => <path d={`M${p.x + 46} ${p.y + 10} Q ${(p.x + 46 + 270) / 2} ${200} 270 ${210}`} stroke={p.color} />)}
    </g>
    <rect x="236" y="214" width="68" height="34" rx="6" fill="#232a78"></rect>
    <rect x="190" y="244" width="160" height="10" rx="5" fill="#232a78"></rect>
    <rect x="100" y="24" width="340" height="200" rx="20" fill="#0b0d26" stroke="#f7f0e3" stroke-width="3"></rect>
    <rect x="116" y="40" width="308" height="168" rx="10" fill="#181d55"></rect>
    <g transform="translate(140 62)">
      <rect width="124" height="124" rx="10" fill="#f7f0e3"></rect>
      <g fill="#10133a" transform="translate(8 8)">
        {qr.filter(([x, y]) => !finder.some(([fx, fy]) => x >= fx && x < fx + 3 && y >= fy && y < fy + 3)).map(([x, y]) => <rect x={x * 12} y={y * 12} width="12" height="12" />)}
        {finder.map(([fx, fy]) => (
          <>
            <rect x={fx * 12} y={fy * 12} width="36" height="36" rx="4" />
            <rect x={fx * 12 + 6} y={fy * 12 + 6} width="24" height="24" rx="2" fill="#f7f0e3" />
            <rect x={fx * 12 + 11} y={fy * 12 + 11} width="14" height="14" rx="2" />
          </>
        ))}
      </g>
    </g>
    <text x="290" y="96" fill="#f7f0e3" opacity="0.6" font-family="'Bricolage Grotesque Variable', sans-serif" font-size="15" font-weight="700" letter-spacing="3">{copy.room}</text>
    <text x="288" y="140" fill="#ffb81c" font-family="'Bricolage Grotesque Variable', sans-serif" font-size="44" font-weight="800" letter-spacing="2">QBXT</text>
    <g transform="translate(292 160)">
      {phones.map((p, i) => <circle cx={i * 28 + 10} cy="12" r="10" fill={p.color} class="pf__dot" style={`animation-delay:${i * 0.4}s`} />)}
    </g>
    {
      phones.map((p, i) => (
        <g transform={`rotate(${p.r} ${p.x + 46} ${p.y + 80})`}>
          <g class="pf__phone" style={`animation-delay:${i * 0.3}s`}>
            <rect x={p.x} y={p.y} width="92" height="150" rx="16" fill="#0b0d26" stroke="#f7f0e3" stroke-width="3" />
            <rect x={p.x + 8} y={p.y + 14} width="76" height="124" rx="8" fill="#1b2163" />
            <circle cx={p.x + 46} cy={p.y + 46} r="16" fill={p.color} />
            <circle cx={p.x + 40} cy={p.y + 43} r="3" fill="#10133a" />
            <circle cx={p.x + 52} cy={p.y + 43} r="3" fill="#10133a" />
            <rect x={p.x + 18} y={p.y + 82} width="56" height="38" rx="19" fill={p.color} />
            <rect x={p.x + 18} y={p.y + 82} width="56" height="38" rx="19" fill="#000" opacity="0.15" class="pf__press" style={`animation-delay:${i * 0.45}s`} />
          </g>
        </g>
      ))
    }
  </svg>
</div>

<style>
  .pf {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  .pf__title {
    margin-block: 20px;
    font-size: clamp(2.3rem, 4.8vw, 4rem);
  }
  .pf__body {
    font-size: 1.15rem;
    opacity: 0.8;
    max-width: 56ch;
  }
  .pf__features {
    display: grid;
    gap: 10px;
    margin-block: 28px 32px;
  }
  .pf__features li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .pf__features :global(svg) {
    flex: none;
    margin-top: 0.3em;
    color: var(--firouzeh);
  }
  .pf__terminal pre {
    padding-inline-end: 80px;
  }
  .pf__link {
    margin-top: 26px;
    color: var(--saffron);
  }
  .pf__art {
    width: 100%;
    overflow: visible;
  }
  .pf__phone,
  .pf__press,
  .pf__dot {
    transform-box: fill-box;
    transform-origin: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pf__wires path {
      animation: pf-flow 1.2s linear infinite;
    }
    .pf__phone {
      animation: pf-float 3.4s ease-in-out infinite;
    }
    .pf__press {
      animation: pf-press 1.8s ease-in-out infinite;
    }
    .pf__dot {
      animation: pf-pop 1.8s var(--ease-spring) infinite;
    }
  }
  @keyframes pf-flow {
    to {
      stroke-dashoffset: -28;
    }
  }
  @keyframes pf-float {
    50% {
      transform: translateY(-8px);
    }
  }
  @keyframes pf-press {
    0%,
    70%,
    100% {
      opacity: 0;
    }
    80% {
      opacity: 0.35;
    }
  }
  @keyframes pf-pop {
    0%,
    70%,
    100% {
      transform: scale(1);
    }
    80% {
      transform: scale(1.3);
    }
  }
  @media (max-width: 900px) {
    .pf {
      grid-template-columns: 1fr;
    }
    .pf__art {
      grid-row: 1;
      max-width: 520px;
      margin-inline: auto;
    }
  }
</style>
