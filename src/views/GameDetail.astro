---
import GameArt from '~/components/GameArt.astro';
import GameCard from '~/components/GameCard.astro';
import Girih from '~/components/Girih.astro';
import Icon from '~/components/Icon.astro';
import Base from '~/layouts/Base.astro';
import { SITE, repoUrl } from '~/config';
import { games, type Game } from '~/data/games';
import { getRepo, isActive } from '~/data/github';
import { formatDate, localize, num, t, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
  game: Game;
}

const { lang, game } = Astro.props;
const ui = t(lang);
const repo = await getRepo(game.repo);
const active = isActive(repo);
const index = games.indexOf(game);
const more = [1, 2, 3].map((n) => games[(index + n) % games.length]);
const otherName = lang === 'en' ? game.native : game.name.en !== game.name.fa ? game.name.en : undefined;

const copy = {
  en: {
    games: 'Games',
    run: 'Run it locally',
    runTitle: 'Play it tonight.',
    runBody: 'Our games are played from source while they grow. You need Git, Node.js and npm. The README covers everything else, from tests to desktop and mobile builds.',
    readme: 'Read the README',
    about: 'About the game',
    highlights: 'Highlights',
    players: 'Players',
    platforms: 'Platforms',
    stack: 'Built with',
    screenshot: 'From the repository',
    more: 'More games',
    issues: 'Report an issue',
  },
  fa: {
    games: 'بازی‌ها',
    run: 'اجرای محلی',
    runTitle: 'همین امشب بازی‌اش کن.',
    runBody: 'بازی‌هایمان تا وقتی در حال رشدند از روی کد اجرا می‌شوند. به Git، Node.js و npm نیاز داری. بقیه‌اش، از تست‌ها تا ساخت نسخهٔ دسکتاپ و موبایل، در README آمده است.',
    readme: 'خواندن README',
    about: 'دربارهٔ بازی',
    highlights: 'ویژگی‌ها',
    players: 'بازیکن',
    platforms: 'سکوها',
    stack: 'ساخته‌شده با',
    screenshot: 'از مخزن بازی',
    more: 'بازی‌های دیگر',
    issues: 'گزارش مشکل',
  },
}[lang];

const commandId = `run-${game.slug}`;
const schema = {
  '@type': 'VideoGame',
  name: game.name[lang],
  alternateName: otherName,
  description: game.summary[lang],
  url: new URL(localize(`/games/${game.slug}/`, lang), SITE.url).href,
  inLanguage: ['fa', 'en'],
  genre: ui.family[game.family],
  gamePlatform: game.platforms.map((p) => t('en').platform[p]),
  applicationCategory: 'Game',
  license: 'https://opensource.org/licenses/MIT',
  isAccessibleForFree: true,
  author: { '@id': `${SITE.url}/#org` },
  publisher: { '@id': `${SITE.url}/#org` },
  sameAs: repoUrl(game.repo),
};
---

<Base lang={lang} title={game.name[lang]} description={game.summary[lang]} schema={schema}>
  <section class="detail-hero" style={`--accent:${game.theme.accent};--art-bg:${game.theme.bg}`}>
    <Girih size={140} />
    <div class="container detail-hero__grid">
      <div class="detail-hero__copy">
        <nav class="crumbs" aria-label={lang === 'en' ? 'Breadcrumb' : 'مسیر'}>
          <a href={localize('/games/', lang)}>{copy.games}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{game.name[lang]}</span>
        </nav>
        <div class="detail-hero__pills">
          <span class="pill">{ui.family[game.family]}</span>
          <span class="pill">{ui.status[game.status]}</span>
          {active && <span class="pill pill--live">{ui.active}</span>}
        </div>
        <h1>
          {game.name[lang]}
          {otherName && <span class:list={['detail-hero__native', lang === 'en' ? 'persian-display' : 'latin']} lang={lang === 'en' ? 'fa' : 'en'}>{otherName}</span>}
        </h1>
        <p class="detail-hero__tagline">{game.tagline[lang]}</p>
        <p class="detail-hero__summary">{game.summary[lang]}</p>
        <div class="btn-row">
          <a class="btn" href={repoUrl(game.repo)}><Icon name="github" />{ui.viewSource}</a>
          <a class="btn btn--ghost" href="#run"><Icon name="play" />{copy.run}</a>
        </div>
      </div>
      <div class="detail-hero__art" data-tilt-art>
        <GameArt slug={game.slug} live />
      </div>
    </div>

    <dl class="container facts">
      <div>
        <dt><Icon name="users" size={16} />{copy.players}</dt>
        <dd>{game.players[lang]}</dd>
      </div>
      <div>
        <dt><Icon name="device" size={16} />{copy.platforms}</dt>
        <dd>{game.platforms.map((p) => ui.platform[p]).join(lang === 'en' ? ', ' : '، ')}</dd>
      </div>
      {
        repo && repo.stars > 0 && (
          <div>
            <dt><Icon name="star" size={16} />{ui.stars}</dt>
            <dd>{num(repo.stars, lang)}</dd>
          </div>
        )
      }
      {
        repo && (
          <div>
            <dt><Icon name="code" size={16} />{ui.updated}</dt>
            <dd>
              <time datetime={repo.pushedAt} data-relative>{formatDate(repo.pushedAt, lang, { day: 'numeric', month: 'long' })}</time>
            </dd>
          </div>
        )
      }
      <div>
        <dt><Icon name="heart" size={16} />{ui.license}</dt>
        <dd>MIT</dd>
      </div>
    </dl>
  </section>

  <section class="section section--paper about">
    <Girih />
    <div class="container about__grid">
      <div class="about__text" data-reveal>
        <p class="eyebrow">{copy.about}</p>
        {game.description[lang].map((p, i) => <p class:list={{ 'about__lede': i === 0 }}>{p}</p>)}
        <h2 class="about__stack-title">{copy.stack}</h2>
        <ul class="about__stack" role="list">
          {game.stack.map((s) => <li class="latin">{s}</li>)}
        </ul>
      </div>
      <div class="about__highlights" data-reveal style="--reveal-delay:120">
        <h2>{copy.highlights}</h2>
        <ol role="list">
          {
            game.highlights[lang].map((h, i) => (
              <li>
                <span class="about__num">{num(i + 1, lang)}</span>
                {h}
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    {
      game.screenshot && (
        <figure class="container shot" data-reveal>
          <div class="shot__frame">
            <div class="shot__bar" aria-hidden="true">
              <i />
              <i />
              <i />
            </div>
            <img src={game.screenshot.src} width={game.screenshot.width} height={game.screenshot.height} alt={game.screenshot.alt[lang]} loading="lazy" decoding="async" />
          </div>
          <figcaption>{copy.screenshot}</figcaption>
        </figure>
      )
    }
  </section>

  <section class="section section--night run" id="run">
    <div class="container run__grid">
      <div data-reveal>
        <p class="eyebrow">{copy.run}</p>
        <h2 class="run__title">{copy.runTitle}</h2>
        <p class="run__body">{copy.runBody}</p>
        <div class="btn-row">
          <a class="btn btn--turquoise" href={`${repoUrl(game.repo)}#readme`}>{copy.readme}<Icon name="arrow" class="flip" /></a>
          <a class="btn btn--ghost" href={`${repoUrl(game.repo)}/issues`}><Icon name="issue" />{copy.issues}</a>
        </div>
      </div>
      <div class="terminal" data-reveal style="--reveal-delay:120">
        <div class="terminal__bar"><i></i><i></i><i></i><span>~/games</span></div>
        <pre id={commandId}>{game.run.split('\n').map((line) => <span data-line><span class="prompt">$ </span>{line}{'\n'}</span>)}</pre>
        <button class="copy-btn" type="button" data-copy={commandId} data-copied={ui.copied}>{ui.copy}</button>
      </div>
    </div>
  </section>

  <section class="section section--paper more">
    <div class="container">
      <div class="more__head">
        <h2>{copy.more}</h2>
        <a class="link-arrow" href={localize('/games/', lang)}>{ui.allGames}<Icon name="arrow" /></a>
      </div>
      <ul class="more__grid" role="list">
        {
          more.map((g) => (
            <li>
              <GameCard game={g} lang={lang} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .detail-hero {
    position: relative;
    padding-top: calc(var(--header-h) + 48px);
    background:
      radial-gradient(800px 600px at 80% 30%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
      var(--night-900);
    overflow: hidden;
    isolation: isolate;
  }
  .detail-hero :global(.girih-bg) {
    opacity: 0.05;
  }
  .detail-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    padding-bottom: 56px;
  }
  .crumbs {
    display: flex;
    gap: 10px;
    font-size: 0.95rem;
    margin-bottom: 22px;
    opacity: 0.75;
  }
  .crumbs a:hover {
    color: var(--saffron);
  }
  .detail-hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
  }
  .detail-hero h1 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 20px;
    font-size: clamp(3rem, 7vw, 6rem);
  }
  .detail-hero__native {
    font-size: 0.55em;
    color: var(--accent);
  }
  .detail-hero__native.latin {
    font-weight: 750;
    letter-spacing: -0.03em;
  }
  .detail-hero__tagline {
    margin-top: 16px;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    font-weight: 650;
    line-height: 1.25;
    color: var(--accent);
  }
  .detail-hero__summary {
    margin-block: 18px 32px;
    font-size: 1.15rem;
    opacity: 0.82;
    max-width: 52ch;
  }
  .detail-hero__art {
    border-radius: var(--radius-l);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--art-bg);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 50px 100px -40px rgb(0 0 0 / 0.7);
    transform: perspective(1400px) rotateY(-6deg) rotateX(3deg);
    transition: transform 0.6s var(--ease-out);
  }
  [dir='rtl'] .detail-hero__art {
    transform: perspective(1400px) rotateY(6deg) rotateX(3deg);
  }
  .detail-hero__art:hover {
    transform: none !important;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    border-radius: var(--radius) var(--radius) 0 0;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .facts div {
    padding: 20px 22px;
    box-shadow:
      inset 1px 0 0 rgb(255 255 255 / 0.08),
      inset 0 1px 0 rgb(255 255 255 / 0.08);
  }
  .facts dt {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    opacity: 0.6;
  }
  .facts dd {
    margin: 6px 0 0;
    font-weight: 650;
  }

  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
  }
  .about__text {
    display: grid;
    gap: 18px;
    align-content: start;
  }
  .about__text p:not(.eyebrow) {
    font-size: 1.12rem;
    color: var(--ink-soft);
  }
  .about__text p.about__lede {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.2vw, 1.8rem);
    font-weight: 650;
    line-height: 1.35;
    color: var(--ink);
  }
  :lang(fa) .about__text p.about__lede {
    font-weight: 400;
    line-height: 1.7;
  }
  .about__stack-title {
    margin-top: 18px;
    font-size: 1.1rem;
    font-family: var(--font-body);
    letter-spacing: 0;
  }
  .about__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .about__stack li {
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--paper-2);
    font-weight: 650;
    font-size: 0.9rem;
  }
  .about__highlights {
    align-self: start;
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radius-l);
    background: var(--ink);
    color: var(--paper);
  }
  .about__highlights h2 {
    font-size: 1.6rem;
    margin-bottom: 18px;
  }
  .about__highlights ol {
    display: grid;
    gap: 4px;
  }
  .about__highlights li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    font-weight: 550;
  }
  .about__highlights li:last-child {
    border-bottom: 0;
  }
  .about__num {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--saffron);
    color: var(--ink);
    font-weight: 800;
    font-size: 0.9rem;
  }
  .about__highlights li:nth-child(2) .about__num {
    background: var(--firouzeh);
  }
  .about__highlights li:nth-child(3) .about__num {
    background: var(--rose);
  }
  .about__highlights li:nth-child(4) .about__num {
    background: var(--orange);
  }

  .shot {
    margin-top: clamp(56px, 8vw, 96px);
  }
  .shot__frame {
    max-width: 1040px;
    margin-inline: auto;
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
    box-shadow: 0 40px 80px -30px rgb(22 26 63 / 0.4);
  }
  .shot__bar {
    display: flex;
    gap: 7px;
    padding: 12px 16px;
    background: var(--paper-2);
  }
  .shot__bar i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--paper-3);
  }
  .shot figcaption {
    margin-top: 14px;
    text-align: center;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .run__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .run__title {
    font-size: clamp(2.4rem, 5vw, 4rem);
    margin-block: 18px 20px;
  }
  .run__body {
    font-size: 1.1rem;
    opacity: 0.8;
    margin-bottom: 28px;
    max-width: 52ch;
  }
  .run .terminal pre {
    padding-inline-end: 80px;
  }

  .more__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 32px;
  }
  .more__head h2 {
    font-size: clamp(2rem, 4vw, 3rem);
  }
  .more__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .more__grid li {
    display: grid;
  }

  @media (max-width: 900px) {
    .detail-hero__grid,
    .about__grid,
    .run__grid {
      grid-template-columns: 1fr;
    }
    .detail-hero__art {
      transform: none !important;
    }
    .more__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
